const String_to_C_String = (s :: String) -> C_String => (
    # TODO
    s.contents
);

const C_String_allocate = (length :: UInt) -> C_String => (
    let cstr :: C_String = @native "malloc(\(length))";
    if @native "!\(cstr)" then (
        panic("Could not allocate a c string");
    );
    cstr
);

const String_free = (s :: String) => (
    @native "free(\(s.contents))";
);

const String_index = (s :: &String, i :: UInt) -> Char => (
    @native "\(s^.contents)[\(i)]"
);

const substring = (s :: &StringView, start :: UInt, end :: UInt) -> StringView => (
    {
        .contents = @native "\(s^.contents) + \(start)",
        .length = sub[UInt](end, start),
    }
);
