const not = (b :: Bool) -> Bool => (
    @native "!\(b)"
);

const Bool_or = (a :: Bool, b :: Bool) -> Bool => (
    @native "\(a) || \(b)"
);

const Char_is_whitespace = (c :: Char) -> Bool => (
    Bool_or(equal[Char](c, ' '), equal[Char](c, '\n'))
);

const inc = [T] (x :: &T) => (
    x^ = add[T](x^, 1);
);

const dec = [T] (x :: &T) => (
    x^ = sub[T](x^, 1);
);

const unreachable = [T] () -> T => (
    panic("unreachable was reached");
    uninitialized
);
