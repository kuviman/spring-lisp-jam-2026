const Parser_skip_whitespace = (reader :: &Reader) => (
    unwindable loop @loop (
        let peek = Reader_peek(reader);
        if not(peek.has_value) then (
            unwind loop with ();
        );
        if not(Char_is_whitespace(peek.value)) then (
            unwind loop with ();
        );
        Reader_advance(reader);
    );
);

const Parser_expect_char = (reader :: &Reader, c :: Char) => (
    let peek = Reader_peek(reader);
    if not(peek.has_value) then (
        error_at(
            Some[Span](Span_zero_width(reader^.source.path, reader^.position)),
            () => (
                print_String("Expected '");
                print_Char(c);
                print_String("', got EOF");
            ),
        );
    );
    if not_equal[Char](peek.value, c) then (
        error_at(
            Some[Span](Span_zero_width(reader^.source.path, reader^.position)),
            () => (
                print_String("Expected '");
                print_Char(c);
                print_String("', got '");
                print_Char(peek.value);
                print_String("'");
            ),
        );
    );
);

const parse = (reader :: &Reader) -> Option[Value] => unwindable return_ (
    Parser_skip_whitespace(reader);
    let start = reader^.position;
    let peek = Reader_peek(reader);
    if not(peek.has_value) then (
        unwind return_ with None[Value]();
    );
    if equal[Char](peek.value, ')') then (
        unwind return_ with None[Value]();
    );
    let result :: Value = uninitialized;
    if equal[Char](peek.value, '(') then (
        Reader_advance(reader);
        let list = ArrayList_new[Value]();
        unwindable loop @loop (
            let next = parse(reader);
            if next.has_value then (
                ArrayList_push_back[Value](&list, next.value);
            ) else (
                unwind loop with ();
            );
        );
        peek = Reader_peek(reader);
        Parser_expect_char(reader, ')');
        Reader_advance(reader);
        result.kind = :List;
        result.data = { .list = list };
    ) else if equal[Char](peek.value, '"') then (
        Reader_advance(reader);
        let start_pos = reader^.position;
        unwindable loop @loop (
            peek = Reader_peek(reader);
            if not(peek.has_value) then (
                unwind loop with ();
            );
            if equal[Char](peek.value, '"') then (
                unwind loop with ();
            );
            Reader_advance(reader);
        );
        let string = substring(
            &reader^.source.contents,
            start_pos.index,
            reader^.position.index,
        );
        Parser_expect_char(reader, '"');
        Reader_advance(reader);
        result.kind = :String;
        result.data = { .string = string };
    ) else if Char_is_digit(peek.value) then (
        let number :: Float64 = 0;
        let had_dot = false;
        let after_dot_multiplier :: Float64 = 0.1;
        unwindable loop @loop (
            peek = Reader_peek(reader);
            if Char_is_digit(peek.value) then (
                let digit = Int_to_Float64(Char_as_digit(peek.value));
                if had_dot then (
                    number = add[Float64](
                        number,
                        mul[Float64](after_dot_multiplier, digit),
                    );
                    after_dot_multiplier = div[Float64](after_dot_multiplier, 10);
                ) else (
                    number = add[Float64](
                        mul[Float64](number, 10),
                        digit,
                    );
                );
                Reader_advance(reader);
            ) else if equal[Char](peek.value, '.') then (
                if had_dot then (
                    error_at(
                        Some[Span](
                            {
                                .path = reader^.source.path,
                                .start = start,
                                .end = reader^.position,
                            }
                        ),
                        () => (
                            print_String("Can only have single '.' in a number");
                        )
                    );
                );
                had_dot = true;
                Reader_advance(reader);
            ) else (
                unwind loop with ();
            );
        );
        result.kind = :Number;
        result.data = { .number = number };
    ) else (
        let start_pos = reader^.position;
        unwindable loop @loop (
            peek = Reader_peek(reader);
            if not(peek.has_value) then (
                unwind loop with ();
            );
            if Char_is_whitespace(peek.value) then (
                unwind loop with ();
            );
            if equal[Char](peek.value, '(') then (
                unwind loop with ();
            );
            if equal[Char](peek.value, ')') then (
                unwind loop with ();
            );
            Reader_advance(reader);
        );
        let name :: StringView = substring(
            &reader^.source.contents,
            start_pos.index,
            reader^.position.index,
        );
        result.kind = :Symbol;
        result.data = { .symbol = name };
    );
    result.span = Some[Span](
        {
            .path = reader^.source.path,
            .start = start,
            .end = reader^.position,
        }
    );
    Some[Value](result)
);
