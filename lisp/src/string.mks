const String_to_C_String = (s :: String) -> C_String => (
    let cstr = C_String_allocate(add[UInt](s.length, 1));
    @native "memcpy(\(cstr), \(s.contents), \(s.length))";
    C_String_index(&cstr, s.length)^ = @native "0"; # TODO '\0'
    cstr
);

const C_String_into_String = (cstr :: C_String) -> String => {
    .length = C_String_length(&cstr),
    .contents = cstr,
};

const C_String_length = (s :: &C_String) -> UInt => (
    @native "strlen(\(s^))"
);

const C_String_allocate = (length :: UInt) -> C_String => (
    let cstr :: C_String = @native "malloc(\(length))";
    if @native "!\(cstr)" then (
        panic("Could not allocate a c string");
    );
    cstr
);

const String_free = (s :: String) => (
    C_String_free(s.contents)
);

const C_String_free = (s :: C_String) => (
    @native "free(\(s))";
);

const String_index = (s :: &String, i :: UInt) -> &Char => (
    C_String_index(&s^.contents, i)
);

const C_String_index = (s :: &C_String, i :: UInt) -> &Char => (
    @native "&\(s^)[\(i)]"
);

const String_equal = (a :: &String, b :: &String) -> Bool => (
    if not_equal[UInt](a^.length, b^.length) then (
        false
    ) else (
        @native "memcmp(\(a^.contents), \(b^.contents), \(a^.length)) == 0"
    )
);

const substring = (s :: &String, start :: UInt, end :: UInt) -> StringView => (
    {
        .contents = @native "\(s^.contents) + \(start)",
        .length = sub[UInt](end, start),
    }
);
