const Span = struct {
    .path :: String,
    .start :: Position,
    .end :: Position,
};

const Span_zero_width = (path :: String, pos :: Position) -> Span => {
    .path = path,
    .start = pos,
    .end = pos,
};

const Span_print = (span :: &Span) => (
    print_String(span^.path);
    print_Char(':');
    Position_print(span^.start);
    if not_equal[UInt](span^.start.index, span^.end.index) then (
        print_Char('-');
        Position_print(span^.end);
    );
);
