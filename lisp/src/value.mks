const ValueKind = enum {
    | :Unit
    | :Number
    | :String
    | :NativeFn
    | :NativeMacro
    | :UserFn
    | :UserMacro
    | :Symbol
    | :List
};

const UserFn = struct {
    .args :: ArrayList[String],
    .body :: Box[Value],
};

const UserMacro = type UserFn;

const NativeFn = struct {
    .name :: String,
    .f :: (ArrayList[Value]) -> Value,
};

const Number = type Float64;

const ValueData = union {
    .unit :: Int, # TODO () isnt working properly, should fix in minikast
    .number :: Number,
    .string :: String,
    .native_fn :: NativeFn,
    .user_fn :: UserFn,
    .native_macro :: NativeFn,
    .user_macro :: UserMacro,
    .symbol :: String,
    .list :: ArrayList[Value],
};

const Value = struct {
    .kind :: ValueKind,
    .data :: ValueData,
    .span :: Option[Span],
};

const Value_unit = () -> Value => {
    .kind = :Unit,
    .data = { .unit = 0 },
    .span = None[Span](),
};

const Value_as_number = (value :: &Value) -> Number => (
    if value^.kind == :Number then () else (
        error_at(
            value^.span,
            () => (
                print_String("Expected a number, got ");
                Value_print(value);
            ),
        );
    );
    value^.data.number
);

const Value_into_list = (value :: Value) -> ArrayList[Value] => (
    if value.kind == :List then () else (
        error_at(
            value.span,
            () => (
                print_String("Expected a list, got ");
                Value_print(&value);
            ),
        );
    );
    value.data.list
);

const Value_into_String = (value :: Value) -> String => (
    if value.kind == :String then () else (
        error_at(
            value.span,
            () => (
                print_String("Expected a string, got ");
                Value_print(&value);
            ),
        );
    );
    value.data.string
);

const Value_into_symbol = (value :: Value) -> String => (
    if value.kind == :Symbol then () else (
        error_at(
            value.span,
            () => (
                print_String("Expected a string, got ");
                Value_print(&value);
            ),
        );
    );
    value.data.symbol
);

const print_Number = (x :: Number) => (
    @native "#include <math.h>";
    if @native "round(\(x)) == \(x)" then (
        print_Int(@native "(int)\(x)");
    ) else (
        print_Float64(x);
    );
);

const Value_print = (value :: &Value) => (
    if value^.kind == :Unit then (
        print_String("()");
    ) else if value^.kind == :Number then (
        print_Number(value^.data.number);
    ) else if value^.kind == :UserFn then (
        print_String("<fn>");
    ) else if value^.kind == :UserMacro then (
        print_String("<macro>");
    ) else if value^.kind == :String then (
        print_String_escaped(value^.data.string);
    ) else if value^.kind == :NativeFn then (
        print_String("<native fn ");
        print_String(value^.data.native_fn.name);
        print_String(">");
    ) else if value^.kind == :NativeMacro then (
        print_String("<native macro ");
        print_String(value^.data.native_fn.name);
        print_String(">");
    ) else if value^.kind == :Symbol then (
        print_String(value^.data.symbol);
    ) else if value^.kind == :List then (
        let multi_line = false;
        print_String("(");
        if multi_line then (
            print_String("\n");
            inc_indentation();
        );
        let list = &value^.data.list;
        let i :: UInt = 0;
        unwindable loop @loop (
            if greater_or_equal[UInt](i, list^.length) then (
                unwind loop with ();
            );
            if not(multi_line) then (
                if not_equal[UInt](i, 0) then (
                    print_String(" ");
                );
            );
            Value_print(ArrayList_index[Value](list, i));
            if multi_line then (
                print_Char('\n');
            );
            i = add[UInt](i, 1);
        );
        if multi_line then (
            dec_indentation();
        );
        print_String(")");
    ) else (
        panic("Unmatched value kind in Value_print");
    );
);
