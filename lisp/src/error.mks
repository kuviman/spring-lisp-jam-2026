const ErrorHandler = struct {
    .error_at :: (span :: Option[Span], message :: () -> ()) -> (),
};
const ErrorHandlerCtx = @context ErrorHandler;

const error_at = (span :: Option[Span], message :: () -> ()) => (
    (@current ErrorHandlerCtx).error_at(span, message);
);

const log_error_at = (span :: Option[Span], message :: () -> ()) => (
    print_String("ERROR");
    if span.has_value then (
        print_String(" at ");
        Span_print(&span.value);
    );
    print_String(":\n");
    message();
    print_Char('\n');
);
