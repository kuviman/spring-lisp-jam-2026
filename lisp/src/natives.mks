const add_natives = (locals :: &Locals) => (
    add_native_fn(locals, "print", native_print);
    add_native_fn(locals, "read_file", native_read_file);
    add_native_fn(locals, "parse", native_parse);
    add_native_fn(locals, "eval", native_eval);
    add_native_fn(locals, "values", native_values);
    add_native_macro(locals, "quote", native_quote);
    add_native_macro(locals, "define", native_define);
);

const add_native_macro = (
    locals :: &Locals,
    name :: String,
    f :: (ArrayList[Value]) -> Value,
) => (
    OrdMap_add[StringView, Value](
        locals,
        name,
        {
            .kind = :NativeMacro,
            .data = {
                .native_macro = {
                    .name = name,
                    .f = f,
                },
            },
        },
    );
);

const add_native_fn = (
    locals :: &Locals,
    name :: String,
    f :: (ArrayList[Value]) -> Value,
) => (
    OrdMap_add[StringView, Value](
        locals,
        name,
        {
            .kind = :NativeFn,
            .data = {
                .native_fn = {
                    .name = name,
                    .f = f,
                },
            },
        },
    );
);

const native_print = (args :: ArrayList[Value]) -> Value => (
    let i :: UInt = 0;
    unwindable loop @loop (
        if greater_or_equal[UInt](i, args.length) then (
            unwind loop with ();
        );
        let arg = ArrayList_index[Value](&args, i);
        if arg^.kind == :String then (
            print_String(arg^.data.string);
        ) else (
            Value_print(arg);
        );
        inc[UInt](&i);
    );
    print_Char('\n');
    Value_unit()
);

const native_values = (args :: ArrayList[Value]) -> Value => {
    .kind = :List,
    .data = { .list = args },
    .span = None[Span](),
};

const expect_single_arg = (args :: ArrayList[Value]) -> Value => (
    if not_equal[UInt](args.length, 1) then (
        error_at(
            None[Span](),
            () => print_String("Expected exactly 1 argument"),
        );
    );
    ArrayList_index[Value](&args, 0)^
);

const expect_single_string_arg = (args :: ArrayList[Value]) -> String => (
    let arg = expect_single_arg(args);
    if arg.kind == :String then () else (
        error_at(
            None[Span](),
            () => (
                print_String("Expected a string argument, got ");
                Value_print(&arg);
            ),
        );
    );
    arg.data.string
);

const native_read_file = (args :: ArrayList[Value]) -> Value => (
    let path = expect_single_string_arg(args);
    let source = Source_read_file(path);
    {
        .kind = :String,
        .data = { .string = source.contents },
        .span = None[Span](),
    }
);

const native_parse = (args :: ArrayList[Value]) -> Value => (
    let source :: Source = {
        .contents = expect_single_string_arg(args),
        .path = "<string>",
    };
    let reader = Reader_new(source);
    let result = parse(&reader);
    if result.has_value then (
        Parser_skip_whitespace(&reader);
        Reader_expect_eof(&reader);
        result.value
    ) else (
        error_at(
            None[Span](),
            () => print_String("string did not contain a value"),
        );
        unreachable[Value]()
    )
);

const native_eval = (args :: ArrayList[Value]) -> Value => (
    eval(&expect_single_arg(args))
);

const native_quote = (args :: ArrayList[Value]) -> Value => (
    expect_single_arg(args)
);

const native_define = (args :: ArrayList[Value]) -> Value => (
    if not_equal[UInt](args.length, 2) then (
        error_at(
            None[Span](),
            () => print_String("Expected exactly 2 arguments"),
        );
    );
    let name_value = ArrayList_index[Value](&args, 0)^;
    if name_value.kind == :Symbol then () else (
        error_at(
            name_value.span,
            () => print_String("Name should be a symbol"),
        );
    );
    let name = name_value.data.symbol;
    let value = eval(ArrayList_index[Value](&args, 1));
    let scope = @context.ScopeCtx;
    OrdMap_add[StringView, Value](&scope^.locals, name, value);
    Value_unit()
);
