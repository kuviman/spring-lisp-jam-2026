const Interpreter = struct {
    .global_scope :: Scope,
};

const InterpreterCtx = @context Interpreter;

const Interpreter_new = () -> Interpreter => {
    .global_scope = {
        .parent = None[&Scope](),
        .locals = (
            let locals = OrdMap_new[String, Value](String_equal);
            add_natives(&locals);
            locals
        ),
    }
};

const Locals = type OrdMap[String, Value];

const Scope = struct {
    .parent :: Option[&Scope],
    .locals :: Locals,
};

const ScopeCtx = @context &Scope;

const lookup_var_in_scope = (
    span :: Option[Span],
    name :: String,
    scope :: &Scope,
) -> &Value => unwindable return_ (
    let local = OrdMap_get[String, Value](&scope^.locals, &name);
    if local.has_value then (
        unwind return_ with local.value;
    );
    if scope^.parent.has_value then (
        lookup_var_in_scope(span, name, scope^.parent.value)
    ) else (
        error_at(
            span,
            () => (
                print_String("Could not find ");
                print_String(name);
                print_String(" in scope");
            ),
        );
        unreachable[&Value]()
    )
);

const lookup_var = (span :: Option[Span], name :: String) -> &Value => (
    lookup_var_in_scope(span, name, @current ScopeCtx)
);

const call_user_fn = (
    span :: Option[Span],
    f :: UserFn,
    args :: ArrayList[Value],
) -> Value => (
    if not_equal[UInt](f.args.length, args.length) then (
        error_at(
            None[Span](),
            () => (
                print_String("Expected ");
                print_UInt(f.args.length);
                print_String(" args, got ");
                print_UInt(args.length);
            ),
        );
    );
    let locals = OrdMap_new[String, Value](String_equal);
    let i :: UInt = 0;
    unwindable loop @loop (
        if greater_or_equal[UInt](i, f.args.length) then (
            unwind loop with ();
        );
        let name = ArrayList_index[String](&f.args, i)^;
        let value = ArrayList_index[Value](&args, i)^;
        OrdMap_add[String, Value](&locals, name, value);
        inc[UInt](&i);
    );
    let f_scope :: Scope = {
        .parent = Some[&Scope](@context.ScopeCtx),
        .locals = locals,
    };
    with ScopeCtx = &f_scope;
    eval(&f.body^)
);

const eval_call = (
    f_span :: Option[Span],
    span :: Option[Span],
    f :: Value,
    args :: ArrayList[Value],
) -> Value => unwindable return_ (
    if f.kind == :NativeMacro then (
        unwind return_ with f.data.native_macro.f(args);
    );
    let i :: UInt = 0;
    unwindable loop @loop (
        if greater_or_equal[UInt](i, args.length) then (
            unwind loop with ();
        );
        let arg = ArrayList_index[Value](&args, i);
        arg^ = eval(arg);
        inc[UInt](&i);
    );
    if f.kind == :NativeFn then (
        unwind return_ with f.data.native_fn.f(args);
    );
    if f.kind == :UserFn then (
        unwind return_ with call_user_fn(span, f.data.user_fn, args);
    );
    error_at(
        f_span,
        () => (
            print_String("Expected a function, got ");
            Value_print(&f);
        ),
    );
    unreachable[Value]()
);

const eval = (sexpr :: &Value) -> Value => unwindable return_ (
    if sexpr^.kind == :Symbol then (
        unwind return_ with lookup_var(sexpr^.span, sexpr^.data.symbol)^;
    );
    if sexpr^.kind == :List then (
        let list = sexpr^.data.list;
        if equal[UInt](list.length, 0) then (
            unwind return_ with Value_unit();
        );
        let first = ArrayList_index[Value](&list, 0);
        let fun = eval(first);
        let args = ArrayList_new[Value]();
        let i :: UInt = 1;
        unwindable loop @loop (
            if greater_or_equal[UInt](i, list.length) then (
                unwind loop with ();
            );
            ArrayList_push_back[Value](&args, ArrayList_index[Value](&list, i)^);
            inc[UInt](&i);
        );
        unwind return_ with eval_call(first^.span, sexpr^.span, fun, args);
    );
    sexpr^
);

const eval_source = (source :: Source) -> Value => (
    let reader = Reader_new(source);
    let sexpr = parse(&reader);
    if sexpr.has_value then (
        # Sexpr_print(&sexpr.value, true);
        # print_String("\n"); 
        Parser_skip_whitespace(&reader);
        Reader_expect_eof(&reader);
        eval(&sexpr.value)
    ) else (
        Value_unit()
    )
);
