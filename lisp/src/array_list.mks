const ArrayList = [T] struct {
    .buffer :: List[T],
    .length :: UInt,
};

const ArrayList_new = [T] () -> ArrayList[T] => (
    {
        .buffer = empty_list[T](),
        .length = 0,
    }
);

const ArrayList_index = [T] (a :: &ArrayList[T], i :: UInt) -> &T => (
    list_index[T](a^.buffer, i)
);

const ArrayList_push_back = [T] (v :: &ArrayList[T], element :: T) -> () => (
    if equal[UInt](v^.length, v^.buffer.length) then (
        let new_capacity :: UInt = if equal[UInt](v^.buffer.length, 0) then (
            4
        ) else (
            mul[UInt](v^.buffer.length, 2)
        );
        let new_buffer = allocate_list[T](new_capacity);
        let T_TypeInfo = @TypeInfo(T);
        let data_size = mul[UInt](T_TypeInfo.stride, v^.buffer.length);
        copy_list[T](new_buffer, 0, v^.buffer, 0, v^.buffer.length);
        free_list[T](v^.buffer);
        v^.buffer = new_buffer;
    );
    list_index[T](v^.buffer, v^.length)^ = element;
    v^.length = add[UInt](v^.length, 1);
);
